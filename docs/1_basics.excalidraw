    {
      "id": "kC4EBIAX7nCk0E8vAPhHh",
      "type": "text",
      "x": 55.799957275390625,
      "y": 102.39999389648438,
      "width": 626.6395263671875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "cLqWLLgahD9nlC6dnnOVT"
      ],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 189806336,
      "version": 414,
      "versionNonce": 2102409472,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780471179239,
      "link": null,
      "locked": false,
      "text": "RAG - It is the process of optimizing the output of an LLM\non a specific knowledge base outside of its training data.\nThis helps in getting relevent responce on that knowledge base\nwithout retraining/finetuning the entire LLM, so rag is also cost\neffective",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RAG - It is the process of optimizing the output of an LLM\non a specific knowledge base outside of its training data.\nThis helps in getting relevent responce on that knowledge base\nwithout retraining/finetuning the entire LLM, so rag is also cost\neffective",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "PaEMi7mnaH_5Tz-L2k0Rf",
